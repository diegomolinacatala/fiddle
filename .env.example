# Copia a .env.local (local) y pega lo mismo en Vercel -> Settings -> Environment Variables.
# Sin nada configurado la app arranca en MODO DEMO (ficheros locales, sin pases reales).

# --- URL pública de ESTA app (sin barra final) ---
# Va dentro de cada pase (QR y webServiceURL). Apple SOLO actualiza pases contra HTTPS.
APP_URL=https://tu-app.vercel.app

# --- Login (usuario + contraseña, por negocio y rol) ---
# Usuarios:  delicanteria = manager · delicanteria-caja = caja
# Secreto para firmar la cookie de sesión. OBLIGATORIO en producción (sin él nadie entra).
# Largo y aleatorio:  openssl rand -hex 32
AUTH_SECRET=

# Cifra nombres y notas de los clientes en la base (docs/PRIVACIDAD.md).
# Genérala con:  npm run clave-cifrado   (-> certs/cifrado.env). Sin ella se
# guardan en claro. PERDERLA ES PERDER ESOS DATOS: guárdala también fuera.
CIFRADO_CLAVE=
# Admin de la plataforma (entra en /admin: crea y edita tiendas).
CLAVE_ADMIN_VICTOR=
CLAVE_ADMIN_DIEGO=

# Contraseña de cada usuario de tienda, SOLO si no la tiene en la base (se generan
# en /admin, tabla accesos). El nombre antiguo PIN_<SLUG>_<ROL> también vale.
CLAVE_DELICANTERIA_MANAGER=
CLAVE_DELICANTERIA_CAJA=
# Accesos de PRUEBA: con esto a 1, vale contraseña = usuario (delicanteria/delicanteria) y el login
# los muestra en pantalla. Fuera de producción está activo solo. QUÍTALO al abrir al público.
USUARIOS_DEMO=

# --- Supabase (obligatorio en producción: en Vercel los ficheros no persisten) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (SOLO backend, nunca en el navegador ni en el repo)
SUPABASE_SERVICE_KEY=

# --- Apple Wallet (cuenta Apple Developer) — proveedor preferido ---
# Se generan con:  npm run apple:csr  ->  (portal de Apple)  ->  npm run apple:env
# Guía: docs/APPLE-WALLET.md. Los certificados van en base64 (una línea).
APPLE_PASS_TYPE_ID=pass.com.tudominio.sellos
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_WWDR_CERT=
# Solo si la clave privada está cifrada:
APPLE_PASS_KEY_PASSPHRASE=
# Pass Type ID propio de una tienda (su tarjeta no se apila con las demás en el
# Wallet). <SLUG> en mayúsculas y "-" -> "_". Mismo CSR que el general.
# Se generan con:  npm run apple:env -- --tienda <slug>
# APPLE_PASS_TYPE_ID_<SLUG>=pass.com.tudominio.<slug>
# APPLE_PASS_CERT_<SLUG>=

# --- Avisos automáticos (docs/AVISOS.md) ---
# Protege /api/cron/avisos, el reloj que los manda. Sin ella no sale ninguno
# automático (los de "Enviar ahora" sí). Cadena larga: openssl rand -hex 32
CRON_SECRET=

# --- WalletWallet (plan B, solo si NO hay variables APPLE_*) ---
WALLETWALLET_API_KEY=

# --- Android: avisos del navegador (opcional) ---
# Sin ellas, las claves se derivan de AUTH_SECRET y los avisos funcionan igual.
# Fijarlas evita que un cambio de AUTH_SECRET obligue a reactivarlos:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Google Wallet (Android, opcional) ---  Guía: docs/GOOGLE-WALLET.md
# Sin credenciales no aparece "Añadir a Google Wallet" (Android usa la tarjeta web).
GOOGLE_WALLET_ISSUER_ID=
# El .json de la cuenta de servicio, tal cual o en base64...
GOOGLE_WALLET_SA_JSON=
# ...o email + clave privada por separado (PEM con \n literales, o en base64).
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
