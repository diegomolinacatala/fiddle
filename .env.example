# --- Autenticación (login de caja y manager) ---
# Secreto para firmar la cookie de sesión (HMAC). Pon una cadena larga y única.
# Si no la defines, se usa un secreto de demo (NO válido para producción).
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# PINs de acceso. worker = caja (solo /w, /worker). manager = acceso total.
WORKER_PIN=1234
MANAGER_PIN=4321

# --- WalletWallet (Apple · firma del pase + push) ---
# Formato: ww_live_<32 hex>. Sácala del dashboard de WalletWallet.
WALLETWALLET_API_KEY=ww_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- URL pública de ESTA app en Vercel (sin barra final) ---
# Se usa para construir el barcode que escanea el camarero: /api/sellar?serial=...
# En local puedes poner un túnel (ngrok) o http://localhost:3000 (el barcode no
# será escaneable desde otro móvil, pero /api/crear funcionará).
APP_URL=https://tu-demo.vercel.app

# --- Google Wallet (Android · opcional) ---
# Sin estas 3, el "Guardar en Google Wallet" no aparece (solo Apple). Con ellas,
# se genera el enlace firmado. Crea Issuer + LoyaltyClass en Google Pay & Wallet
# Console y una cuenta de servicio con permiso sobre el issuer.
GOOGLE_WALLET_ISSUER_ID=3388000000022000000
GOOGLE_WALLET_SA_EMAIL=fidelizacion@tu-proyecto.iam.gserviceaccount.com
# Private key de la cuenta de servicio. Pega el PEM en una línea con \n literales.
GOOGLE_WALLET_SA_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Sufijo de la LoyaltyClass ya creada en la consola (id = <issuer>.<sufijo>).
GOOGLE_WALLET_CLASS_SUFFIX=fidelizacion

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (SOLO backend, nunca en el navegador ni en el repo)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Opcionales: valores por defecto del programa (editables luego en /manager) ---
SELLOS_TOTAL=10
CARD_TITLE=Café Demo
PREMIO=Café gratis
# colorPreset (plan Free): dark | blue | green | red | purple | orange
CARD_COLOR=dark
