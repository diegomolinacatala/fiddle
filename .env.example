# --- WalletWallet (firma del pase + push) ---
# Formato: ww_live_<32 hex>. Sácala del dashboard de WalletWallet.
WALLETWALLET_API_KEY=ww_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- URL pública de ESTA app en Vercel (sin barra final) ---
# Se usa para construir el barcode que escanea el camarero: /api/sellar?serial=...
# En local puedes poner un túnel (ngrok) o http://localhost:3000 (el barcode no
# será escaneable desde otro móvil, pero /api/crear funcionará).
APP_URL=https://tu-demo.vercel.app

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (SOLO backend, nunca en el navegador ni en el repo)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Opcionales: valores por defecto del programa (editables luego en /manager) ---
SELLOS_TOTAL=10
CARD_TITLE=Café Demo
PREMIO=Café gratis
# colorPreset (plan Free): dark | blue | green | red | purple | orange
CARD_COLOR=dark
